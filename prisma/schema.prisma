generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AuthThrottleScope {
  ACCOUNT
  SOURCE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum RevisionStatus {
  DRAFT
  REVIEW
  PUBLISHED
  RETIRED
}

enum FoldDocumentType {
  NORMAL
  BOX
  PANEL
}

enum CalculationMode {
  FIXED
  RATIO
}

enum DecimalOperation {
  NONE
  ROUND
  FLOOR
  CEIL
}

enum MaterialElongationOption {
  STANDARD
  TWO_LINE
  DIAGONAL
  EXT1
}

enum SheetRotationPolicy {
  FREE
  KEEP_GRAIN
}

enum SheetGrainAxis {
  NONE
  WIDTH
  LENGTH
}

enum SheetInventoryUnit {
  SHEET
}

enum FileAssetKind {
  FOLD_DOCUMENT
  PREVIEW
  DXF
  PDF
  IMPORT_SOURCE
  OTHER
}

enum FileAssetStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum MachineIntegrationStatus {
  PLANNED
  DISABLED
}

enum BusinessSiteType {
  HEAD_OFFICE
  FACTORY
  BRANCH
  OTHER
}

enum CustomerType {
  SALES
  PURCHASE
  TEMPORARY
  INTERNAL
  OTHER
}

enum PriceScopeType {
  STANDARD
  TIER
  CUSTOMER
}

enum SalesOrderStatus {
  DRAFT
  CALCULATED
  APPROVED
  PRODUCTION_REQUESTED
  IN_PRODUCTION
  PRODUCED
  CLOSED
  CANCELLED
}

enum CuttingPlanStatus {
  PENDING
  CALCULATED
  APPROVED
  FAILED
}

enum CuttingPlanRevisionStatus {
  QUEUED
  SUCCEEDED
  FAILED
}

/// 원판 사용 기록의 유효 여부(`D2-B06-F`). 승인을 취소해도 지우지 않고 무효로 둔다.
enum SheetUsageStatus {
  ACTIVE
  VOID
}

enum SurchargeBaseType {
  PROCESSING_ONLY
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AuditCategory {
  AUTHENTICATION
  ADMINISTRATION
  DATA_CHANGE
  APPROVAL
  OUTPUT
  MACHINE
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum AuditSource {
  WEB
  CLI
  SYSTEM
}

model Organization {
  id                         String                              @id @default(uuid()) @db.Uuid
  code                       String                              @unique @db.VarChar(50)
  name                       String                              @db.VarChar(200)
  status                     OrganizationStatus                  @default(ACTIVE)
  lockVersion                Int                                 @default(1)
  createdAt                  DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                            @updatedAt @db.Timestamptz(6)
  companyProfile             CompanyProfile?
  customerCodeCounter        CustomerCodeCounter?
  businessSites              BusinessSite[]
  memberships                OrganizationMembership[]
  departments                Department[]
  roles                      Role[]
  customers                  Customer[]
  customerContacts           CustomerContact[]
  customerSites              CustomerSite[]
  salesOrders                SalesOrder[]
  salesOrderFoldItems        SalesOrderFoldItem[]
  salesOrderCalculations     SalesOrderCalculationSnapshot[]
  salesOrderFoldCalculations SalesOrderFoldCalculationSnapshot[]
  salesOrderNumberCounters   SalesOrderNumberCounter[]
  priceTiers                 PriceTier[]
  priceBooks                 PriceBook[]
  priceBookRevisions         PriceBookRevision[]
  foldPriceRates             FoldPriceRate[]
  sheetPriceRates            SheetPriceRate[]
  surchargePolicies          SurchargePolicy[]
  materials                  Material[]
  materialVariants           MaterialVariant[]
  materialRuleRevisions      MaterialRuleRevision[]
  sheetItems                 SheetItem[]
  foldCategories             FoldCategory[]
  foldTemplates              FoldTemplate[]
  foldRevisions              FoldRevision[]
  fileAssets                 FileAsset[]
  machineIntegrationConfig   MachineIntegrationConfig?
  auditEvents                AuditEvent[]
  legacyMappings             LegacyMapping[]
  jobs                       JobQueue[]
  cuttingPlans               CuttingPlan[]
  cuttingPlanRevisions       CuttingPlanRevision[]
  sheetUsageRecords          SheetUsageRecord[]

  @@index([status])
}

model CompanyProfile {
  organizationId             String       @id @db.Uuid
  businessRegistrationNumber String?      @db.VarChar(20)
  representativeName         String?      @db.VarChar(100)
  phone                      String?      @db.VarChar(30)
  email                      String?      @db.VarChar(320)
  postalCode                 String?      @db.VarChar(20)
  addressLine1               String?      @db.VarChar(300)
  addressLine2               String?      @db.VarChar(300)
  lockVersion                Int          @default(1)
  createdAt                  DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime     @updatedAt @db.Timestamptz(6)
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BusinessSite {
  id                         String           @id @default(uuid()) @db.Uuid
  organizationId             String           @db.Uuid
  code                       String           @db.VarChar(50)
  name                       String           @db.VarChar(200)
  type                       BusinessSiteType @default(OTHER)
  businessRegistrationNumber String?          @db.VarChar(20)
  representativeName         String?          @db.VarChar(100)
  phone                      String?          @db.VarChar(30)
  email                      String?          @db.VarChar(320)
  postalCode                 String?          @db.VarChar(20)
  addressLine1               String?          @db.VarChar(300)
  addressLine2               String?          @db.VarChar(300)
  isDefault                  Boolean          @default(false)
  active                     Boolean          @default(true)
  lockVersion                Int              @default(1)
  deletedAt                  DateTime?        @db.Timestamptz(6)
  createdAt                  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime         @updatedAt @db.Timestamptz(6)
  organization               Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@index([organizationId, active, name])
  @@index([organizationId, isDefault])
}

model User {
  id                              String                   @id @default(uuid()) @db.Uuid
  email                           String                   @unique @db.VarChar(320)
  normalizedEmail                 String                   @unique @db.VarChar(320)
  displayName                     String                   @db.VarChar(100)
  status                          UserStatus               @default(INVITED)
  lastLoginAt                     DateTime?                @db.Timestamptz(6)
  createdAt                       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime                 @updatedAt @db.Timestamptz(6)
  passwordCredential              PasswordCredential?
  sessions                        AuthSession[]
  passwordResetTokens             PasswordResetToken[]
  memberships                     OrganizationMembership[]
  createdMaterialRuleRevisions    MaterialRuleRevision[]   @relation("MaterialRuleCreatedBy")
  updatedMaterialRuleRevisions    MaterialRuleRevision[]   @relation("MaterialRuleUpdatedBy")
  statusChangedMaterialRules      MaterialRuleRevision[]   @relation("MaterialRuleStatusChangedBy")
  deletedMaterialRuleRevisions    MaterialRuleRevision[]   @relation("MaterialRuleDeletedBy")
  publishedMaterialRuleRevisions  MaterialRuleRevision[]   @relation("MaterialRulePublishedBy")
  createdPriceBookRevisions       PriceBookRevision[]      @relation("PriceBookRevisionCreatedBy")
  updatedPriceBookRevisions       PriceBookRevision[]      @relation("PriceBookRevisionUpdatedBy")
  statusChangedPriceBookRevisions PriceBookRevision[]      @relation("PriceBookRevisionStatusChangedBy")
  deletedPriceBookRevisions       PriceBookRevision[]      @relation("PriceBookRevisionDeletedBy")
  publishedPriceBookRevisions     PriceBookRevision[]      @relation("PriceBookRevisionPublishedBy")
  createdFoldRevisions            FoldRevision[]           @relation("FoldRevisionCreatedBy")
  updatedFoldRevisions            FoldRevision[]           @relation("FoldRevisionUpdatedBy")
  statusChangedFoldRevisions      FoldRevision[]           @relation("FoldRevisionStatusChangedBy")
  deletedFoldRevisions            FoldRevision[]           @relation("FoldRevisionDeletedBy")
  publishedFoldRevisions          FoldRevision[]           @relation("FoldRevisionPublishedBy")
  uploadedFileAssets              FileAsset[]              @relation("FileAssetUploadedBy")
  auditEvents                     AuditEvent[]             @relation("AuditActor")

  @@index([status])
  @@index([displayName])
}

model PasswordCredential {
  userId            String   @id @db.Uuid
  algorithm         String   @db.VarChar(50)
  passwordHash      String   @db.VarChar(500)
  passwordChangedAt DateTime @default(now()) @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(6)
  lastSeenAt DateTime? @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuthThrottle {
  scope           AuthThrottleScope
  keyHash         String            @db.Char(64)
  windowStartedAt DateTime          @db.Timestamptz(6)
  failureCount    Int               @default(0)
  blockedUntil    DateTime?         @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)

  @@id([scope, keyHash])
  @@index([blockedUntil])
}

model Department {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  code           String                   @db.VarChar(50)
  name           String                   @db.VarChar(100)
  active         Boolean                  @default(true)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(6)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships    OrganizationMembership[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model OrganizationMembership {
  id                            String                          @id @default(uuid()) @db.Uuid
  organizationId                String                          @db.Uuid
  userId                        String                          @db.Uuid
  departmentId                  String?                         @db.Uuid
  status                        MembershipStatus                @default(ACTIVE)
  joinedAt                      DateTime                        @default(now()) @db.Timestamptz(6)
  createdAt                     DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime                        @updatedAt @db.Timestamptz(6)
  organization                  Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                          User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  department                    Department?                     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles                         MembershipRole[]
  ownedSalesOrders              SalesOrder[]                    @relation("SalesOrderOwner")
  cancelledSalesOrders          SalesOrder[]                    @relation("SalesOrderCanceller")
  approvedSalesOrders           SalesOrder[]                    @relation("SalesOrderApprover")
  statusChangedSalesOrders      SalesOrder[]                    @relation("SalesOrderStatusChanger")
  createdSalesOrderFoldItems    SalesOrderFoldItem[]            @relation("SalesOrderFoldItemCreator")
  updatedSalesOrderFoldItems    SalesOrderFoldItem[]            @relation("SalesOrderFoldItemUpdater")
  removedSalesOrderFoldItems    SalesOrderFoldItem[]            @relation("SalesOrderFoldItemRemover")
  createdSalesOrderCalculations SalesOrderCalculationSnapshot[] @relation("SalesOrderCalculationCreator")
  requestedJobs                 JobQueue[]                      @relation("JobQueueRequester")
  createdCuttingPlans           CuttingPlan[]                   @relation("CuttingPlanCreator")
  approvedCuttingPlans          CuttingPlan[]                   @relation("CuttingPlanApprover")
  createdCuttingPlanRevisions   CuttingPlanRevision[]           @relation("CuttingPlanRevisionCreator")

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([departmentId])
  @@index([organizationId, status])
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  key            String           @db.VarChar(100)
  name           String           @db.VarChar(100)
  description    String?          @db.VarChar(500)
  system         Boolean          @default(false)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships    MembershipRole[]
  permissions    RolePermission[]

  @@unique([organizationId, key])
  @@index([organizationId, active])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(150)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  roles       RolePermission[]
}

model MembershipRole {
  membershipId String                 @db.Uuid
  roleId       String                 @db.Uuid
  assignedAt   DateTime               @default(now()) @db.Timestamptz(6)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  grantedAt    DateTime   @default(now()) @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Customer {
  id                         String            @id @default(uuid()) @db.Uuid
  organizationId             String            @db.Uuid
  priceTierId                String?           @db.Uuid
  code                       String            @db.VarChar(50)
  type                       CustomerType      @default(SALES)
  name                       String            @db.VarChar(200)
  normalizedName             String            @db.VarChar(200)
  businessRegistrationNumber String?           @db.VarChar(20)
  representativeName         String?           @db.VarChar(100)
  phone                      String?           @db.VarChar(30)
  fax                        String?           @db.VarChar(30)
  email                      String?           @db.VarChar(320)
  website                    String?           @db.VarChar(500)
  postalCode                 String?           @db.VarChar(20)
  addressLine1               String?           @db.VarChar(300)
  addressLine2               String?           @db.VarChar(300)
  taxInvoiceEnabled          Boolean           @default(true)
  memo                       String?           @db.Text
  active                     Boolean           @default(true)
  lockVersion                Int               @default(1)
  deletedAt                  DateTime?         @db.Timestamptz(6)
  createdAt                  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime          @updatedAt @db.Timestamptz(6)
  organization               Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  priceTier                  PriceTier?        @relation(fields: [priceTierId], references: [id], onDelete: SetNull)
  contacts                   CustomerContact[]
  sites                      CustomerSite[]
  priceBooks                 PriceBook[]
  salesOrders                SalesOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, normalizedName])
  @@index([organizationId, type, active, deletedAt])
  @@index([organizationId, active, deletedAt])
  @@index([priceTierId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_name_trgm_idx")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_code_trgm_idx")
}

model CustomerCodeCounter {
  organizationId String       @id @db.Uuid
  nextValue      Int          @default(1)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CustomerContact {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  customerId     String        @db.Uuid
  customerSiteId String?       @db.Uuid
  name           String        @db.VarChar(100)
  department     String?       @db.VarChar(100)
  title          String?       @db.VarChar(100)
  phone          String?       @db.VarChar(30)
  mobile         String?       @db.VarChar(30)
  email          String?       @db.VarChar(320)
  isPrimary      Boolean       @default(false)
  active         Boolean       @default(true)
  lockVersion    Int           @default(1)
  deletedAt      DateTime?     @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite   CustomerSite? @relation(fields: [customerSiteId], references: [id], onDelete: Restrict)
  salesOrders    SalesOrder[]

  @@index([organizationId, customerId, active, deletedAt])
  @@index([customerSiteId])
}

model CustomerSite {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  customerId     String            @db.Uuid
  code           String            @db.VarChar(50)
  name           String            @db.VarChar(200)
  phone          String?           @db.VarChar(30)
  postalCode     String?           @db.VarChar(20)
  addressLine1   String?           @db.VarChar(300)
  addressLine2   String?           @db.VarChar(300)
  memo           String?           @db.Text
  isDefault      Boolean           @default(false)
  active         Boolean           @default(true)
  lockVersion    Int               @default(1)
  deletedAt      DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contacts       CustomerContact[]
  salesOrders    SalesOrder[]

  @@unique([organizationId, customerId, code])
  @@index([organizationId, name])
  @@index([organizationId, customerId, isDefault])
  @@index([customerId, active, deletedAt])
}

model SalesOrderNumberCounter {
  organizationId String       @db.Uuid
  sequenceYear   Int
  nextValue      Int          @default(1)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, sequenceYear])
}

model SalesOrder {
  id                            String                          @id @default(uuid()) @db.Uuid
  organizationId                String                          @db.Uuid
  orderNumber                   String                          @db.VarChar(50)
  sequenceYear                  Int
  status                        SalesOrderStatus                @default(DRAFT)
  customerId                    String                          @db.Uuid
  customerSiteId                String?                         @db.Uuid
  customerContactId             String?                         @db.Uuid
  ownerMembershipId             String?                         @db.Uuid
  orderedAt                     DateTime                        @default(now()) @db.Date
  dueDate                       DateTime?                       @db.Date
  externalReference             String?                         @db.VarChar(200)
  memo                          String?                         @db.Text
  cancelledAt                   DateTime?                       @db.Timestamptz(6)
  cancelledByMembershipId       String?                         @db.Uuid
  cancellationReason            String?                         @db.VarChar(500)
  approvedCalculationSnapshotId String?                         @unique @db.Uuid
  approvedAt                    DateTime?                       @db.Timestamptz(6)
  approvedByMembershipId        String?                         @db.Uuid
  statusChangedAt               DateTime                        @default(now()) @db.Timestamptz(6)
  statusChangedByMembershipId   String?                         @db.Uuid
  partySnapshotSchemaVersion    Int?
  partySnapshot                 Json?                           @db.JsonB
  partySnapshotChecksumSha256   String?                         @db.Char(64)
  partySnapshotCapturedAt       DateTime?                       @db.Timestamptz(6)
  nextFoldLineNumber            Int                             @default(1)
  nextCalculationNumber         Int                             @default(1)
  lockVersion                   Int                             @default(1)
  createdAt                     DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime                        @updatedAt @db.Timestamptz(6)
  organization                  Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer                      Customer                        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSite                  CustomerSite?                   @relation(fields: [customerSiteId], references: [id], onDelete: Restrict)
  customerContact               CustomerContact?                @relation(fields: [customerContactId], references: [id], onDelete: Restrict)
  ownerMembership               OrganizationMembership?         @relation("SalesOrderOwner", fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  cancelledByMembership         OrganizationMembership?         @relation("SalesOrderCanceller", fields: [cancelledByMembershipId], references: [id], onDelete: Restrict)
  approvedByMembership          OrganizationMembership?         @relation("SalesOrderApprover", fields: [approvedByMembershipId], references: [id], onDelete: Restrict)
  statusChangedByMembership     OrganizationMembership?         @relation("SalesOrderStatusChanger", fields: [statusChangedByMembershipId], references: [id], onDelete: Restrict)
  approvedCalculationSnapshot   SalesOrderCalculationSnapshot?  @relation("SalesOrderApprovedCalculation", fields: [approvedCalculationSnapshotId], references: [id], onDelete: Restrict)
  foldItems                     SalesOrderFoldItem[]
  calculationSnapshots          SalesOrderCalculationSnapshot[]
  attachments                   FileAsset[]
  cuttingPlans                  CuttingPlan[]
  sheetUsageRecords             SheetUsageRecord[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, customerId, updatedAt])
}

model SalesOrderFoldItem {
  id                           String                              @id @default(uuid()) @db.Uuid
  organizationId               String                              @db.Uuid
  salesOrderId                 String                              @db.Uuid
  lineNumber                   Int
  sortOrder                    Int
  sourceFoldTemplateId         String                              @db.Uuid
  sourceFoldRevisionId         String                              @db.Uuid
  sourceTemplateCode           String                              @db.VarChar(50)
  sourceTemplateName           String                              @db.VarChar(200)
  sourceRevisionNumber         Int
  sourceDocumentChecksumSha256 String                              @db.Char(64)
  name                         String                              @db.VarChar(200)
  quantity                     Int
  materialRuleRevisionId       String                              @db.Uuid
  sheetItemId                  String?                             @db.Uuid
  documentSchemaVersion        Int
  document                     Json                                @db.JsonB
  documentChecksumSha256       String                              @db.Char(64)
  lockVersion                  Int                                 @default(1)
  createdByMembershipId        String                              @db.Uuid
  updatedByMembershipId        String                              @db.Uuid
  removedByMembershipId        String?                             @db.Uuid
  removedAt                    DateTime?                           @db.Timestamptz(6)
  createdAt                    DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                            @updatedAt @db.Timestamptz(6)
  organization                 Organization                        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesOrder                   SalesOrder                          @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  sourceFoldTemplate           FoldTemplate                        @relation("SalesOrderFoldItemSourceTemplate", fields: [sourceFoldTemplateId], references: [id], onDelete: Restrict)
  sourceFoldRevision           FoldRevision                        @relation("SalesOrderFoldItemSourceRevision", fields: [sourceFoldRevisionId], references: [id], onDelete: Restrict)
  materialRuleRevision         MaterialRuleRevision                @relation(fields: [materialRuleRevisionId], references: [id], onDelete: Restrict)
  sheetItem                    SheetItem?                          @relation(fields: [sheetItemId], references: [id], onDelete: Restrict)
  createdByMembership          OrganizationMembership              @relation("SalesOrderFoldItemCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  updatedByMembership          OrganizationMembership              @relation("SalesOrderFoldItemUpdater", fields: [updatedByMembershipId], references: [id], onDelete: Restrict)
  removedByMembership          OrganizationMembership?             @relation("SalesOrderFoldItemRemover", fields: [removedByMembershipId], references: [id], onDelete: Restrict)
  calculationSnapshots         SalesOrderFoldCalculationSnapshot[]

  @@unique([salesOrderId, lineNumber])
  @@index([organizationId, salesOrderId, removedAt, sortOrder, id], map: "SalesOrderFoldItem_order_active_sort_idx")
  @@index([sourceFoldTemplateId])
  @@index([sourceFoldRevisionId])
  @@index([materialRuleRevisionId])
  @@index([sheetItemId])
}

model SalesOrderCalculationSnapshot {
  id                    String                              @id @default(uuid()) @db.Uuid
  organizationId        String                              @db.Uuid
  salesOrderId          String                              @db.Uuid
  snapshotNumber        Int
  inputChecksumSha256   String                              @db.Char(64)
  resultChecksumSha256  String                              @db.Char(64)
  pricingEngineVersion  String                              @db.VarChar(50)
  pricingMetricsVersion String                              @db.VarChar(50)
  priceEffectiveAt      DateTime                            @db.Timestamptz(6)
  currency              String                              @default("KRW") @db.Char(3)
  vatRatePercent        Decimal                             @default(10) @db.Decimal(9, 4)
  supplyAmountKrw       Decimal                             @db.Decimal(20, 0)
  vatAmountKrw          Decimal                             @db.Decimal(20, 0)
  totalAmountKrw        Decimal                             @db.Decimal(20, 0)
  itemCount             Int
  createdByMembershipId String                              @db.Uuid
  createdAt             DateTime                            @default(now()) @db.Timestamptz(6)
  organization          Organization                        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesOrder            SalesOrder                          @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  createdByMembership   OrganizationMembership              @relation("SalesOrderCalculationCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  itemSnapshots         SalesOrderFoldCalculationSnapshot[]
  approvedOrder         SalesOrder?                         @relation("SalesOrderApprovedCalculation")

  @@unique([salesOrderId, snapshotNumber])
  @@index([organizationId, salesOrderId, snapshotNumber], map: "SalesOrderCalculationSnapshot_organizationId_salesOrderId_snaps")
  @@index([createdByMembershipId])
}

model SalesOrderFoldCalculationSnapshot {
  id                         String                        @id @default(uuid()) @db.Uuid
  organizationId             String                        @db.Uuid
  orderCalculationSnapshotId String                        @db.Uuid
  salesOrderFoldItemId       String                        @db.Uuid
  lineNumber                 Int
  name                       String                        @db.VarChar(200)
  quantity                   Int
  materialRuleRevisionId     String                        @db.Uuid
  itemDocumentChecksumSha256 String                        @db.Char(64)
  inputChecksumSha256        String                        @db.Char(64)
  resultChecksumSha256       String                        @db.Char(64)
  metrics                    Json                          @db.JsonB
  pricingResult              Json                          @db.JsonB
  materialAmountKrw          Decimal                       @db.Decimal(20, 0)
  bendAmountKrw              Decimal                       @db.Decimal(20, 0)
  vCutAmountKrw              Decimal                       @db.Decimal(20, 0)
  surchargeAmountKrw         Decimal                       @db.Decimal(20, 0)
  supplyAmountKrw            Decimal                       @db.Decimal(20, 0)
  createdAt                  DateTime                      @default(now()) @db.Timestamptz(6)
  organization               Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orderCalculationSnapshot   SalesOrderCalculationSnapshot @relation(fields: [orderCalculationSnapshotId], references: [id], onDelete: Cascade, map: "SalesOrderFoldCalculationSnapshot_orderCalculationSnapshotId_fk")
  salesOrderFoldItem         SalesOrderFoldItem            @relation(fields: [salesOrderFoldItemId], references: [id], onDelete: Restrict)

  @@unique([orderCalculationSnapshotId, salesOrderFoldItemId], map: "SalesOrderFoldCalculationSnapshot_order_item_key")
  @@index([organizationId, orderCalculationSnapshotId, lineNumber], map: "SalesOrderFoldCalculationSnapshot_order_line_idx")
  @@index([salesOrderFoldItemId])
}

model Material {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
