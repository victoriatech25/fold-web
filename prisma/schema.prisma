  deletedBy             User?            @relation("PriceBookRevisionDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  publishedBy           User?            @relation("PriceBookRevisionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
