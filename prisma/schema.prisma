  requestedByMembership   OrganizationMembership @relation("JobQueueRequester", fields: [requestedByMembershipId], references: [id], onDelete: Restrict)
  cuttingPlanRevisions    CuttingPlanRevision[]

  @@unique([organizationId, type, idempotencyKey])
  @@index([status, priority, availableAt, id], map: "JobQueue_claim_idx")
  @@index([status, leaseExpiresAt], map: "JobQueue_lease_reclaim_idx")
  @@index([organizationId, status, createdAt, id], map: "JobQueue_organization_list_idx")
  @@index([requestedByMembershipId])
}

model MachineIntegrationConfig {
  organizationId  String                   @id @db.Uuid
  status          MachineIntegrationStatus @default(PLANNED)
  contractVersion String                   @default("placeholder-v1") @db.VarChar(50)
  note            String?                  @db.VarChar(500)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(6)
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @db.Uuid
  category           AuditCategory
  outcome            AuditOutcome
  source             AuditSource
  schemaVersion      Int           @default(2) @db.SmallInt
  actorUserId        String?       @db.Uuid
  actorDisplayName   String?       @db.VarChar(100)
  actorEmail         String?       @db.VarChar(320)
  subjectFingerprint String?       @db.Char(64)
  sourceFingerprint  String?       @db.Char(64)
  action             String        @db.VarChar(150)
  entityType         String        @db.VarChar(100)
  entityId           String?       @db.VarChar(100)
  requestId          String?       @db.VarChar(100)
  occurredAt         DateTime      @default(now()) @db.Timestamptz(6)
  before             Json?         @db.JsonB
  after              Json?         @db.JsonB
  metadata           Json?         @db.JsonB
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor              User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt, id])
  @@index([organizationId, category, occurredAt, id])
  @@index([organizationId, action, occurredAt, id])
  @@index([organizationId, actorUserId, occurredAt, id])
  @@index([organizationId, entityType, entityId, occurredAt, id])
  @@index([requestId])
}

model LegacyMapping {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  sourceSystem   String       @db.VarChar(100)
  sourceTable    String       @db.VarChar(100)
  legacyKey      String       @db.VarChar(500)
  entityType     String       @db.VarChar(100)
  entityId       String       @db.Uuid
  sourceChecksum String?      @db.Char(64)
  importedAt     DateTime     @default(now()) @db.Timestamptz(6)
  metadata       Json?        @db.JsonB
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceSystem, sourceTable, legacyKey])
  @@index([organizationId, entityType, entityId])
  @@index([sourceSystem, sourceTable])
}

/**
 * 재단 작업(`P2-B05`). 수주 하나와 재질 변형 하나가 한 작업이다(`D2-B05-I`).
 * 재단 입력은 만들 때 통째로 얼려 둔다. 기준정보가 나중에 바뀌어도 승인된
 * 결과를 그때 입력으로 다시 설명할 수 있어야 한다(`D2-B05-D`).
 */
model CuttingPlan {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @db.Uuid
  salesOrderId           String                  @db.Uuid
  materialVariantId      String                  @db.Uuid
  status                 CuttingPlanStatus       @default(PENDING)
  contractVersion        String                  @db.VarChar(50)
  input                  Json                    @db.JsonB
  inputChecksumSha256    String                  @db.Char(64)
  nextRevisionNumber     Int                     @default(1)
  currentRevisionId      String?                 @unique @db.Uuid
  approvedRevisionId     String?                 @unique @db.Uuid
  approvedAt             DateTime?               @db.Timestamptz(6)
  approvedByMembershipId String?                 @db.Uuid
  lockVersion            Int                     @default(1)
  createdByMembershipId  String                  @db.Uuid
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesOrder             SalesOrder              @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  materialVariant        MaterialVariant         @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)
  createdByMembership    OrganizationMembership  @relation("CuttingPlanCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  approvedByMembership   OrganizationMembership? @relation("CuttingPlanApprover", fields: [approvedByMembershipId], references: [id], onDelete: Restrict)
  currentRevision        CuttingPlanRevision?    @relation("CuttingPlanCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  approvedRevision       CuttingPlanRevision?    @relation("CuttingPlanApprovedRevision", fields: [approvedRevisionId], references: [id], onDelete: Restrict)
  revisions              CuttingPlanRevision[]   @relation("CuttingPlanRevisions")
  sheetUsageRecords      SheetUsageRecord[]

  @@unique([salesOrderId, materialVariantId])
  @@index([organizationId, status, updatedAt], map: "CuttingPlan_organization_status_idx")
  @@index([organizationId, salesOrderId], map: "CuttingPlan_organization_order_idx")
}

/**
 * 재단 실행 한 번. 다시 돌리면 덮어쓰지 않고 개정이 쌓인다(`D2-B05-H`).
 * `pins` 는 사용자가 손으로 지시한 고정 배치다(`D2-B05-J`).
 */
model CuttingPlanRevision {
  id                    String                    @id @default(uuid()) @db.Uuid
  organizationId        String                    @db.Uuid
  cuttingPlanId         String                    @db.Uuid
  revisionNumber        Int
  status                CuttingPlanRevisionStatus @default(QUEUED)
  jobId                 String?                   @db.Uuid
  pins                  Json                      @db.JsonB
  engineVersion         String?                   @db.VarChar(50)
  result                Json?                     @db.JsonB
  sheetCount            Int?
  usedAreaM2            Decimal?                  @db.Decimal(18, 8)
  totalAreaM2           Decimal?                  @db.Decimal(18, 8)
  yieldPercent          Decimal?                  @db.Decimal(6, 2)
  unplacedQuantity      Int?
  failureReason         String?                   @db.VarChar(500)
  createdByMembershipId String                    @db.Uuid
  createdAt             DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(6)
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cuttingPlan           CuttingPlan               @relation("CuttingPlanRevisions", fields: [cuttingPlanId], references: [id], onDelete: Cascade)
  job                   JobQueue?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdByMembership   OrganizationMembership    @relation("CuttingPlanRevisionCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  currentOfPlan         CuttingPlan?              @relation("CuttingPlanCurrentRevision")
  approvedOfPlan        CuttingPlan?              @relation("CuttingPlanApprovedRevision")
  sheetUsageRecords     SheetUsageRecord[]

  @@unique([cuttingPlanId, revisionNumber], map: "CuttingPlanRevision_plan_revision_key")
  @@index([organizationId, cuttingPlanId, revisionNumber], map: "CuttingPlanRevision_plan_number_idx")
  @@index([jobId])
}

/**
 * 승인된 재단 개정 하나가 쓴 원판 실적(`D2-B06-A`·`D2-B06-B`).
 * 원판 후보 하나가 한 줄이다. 같은 규격을 여러 장 썼으면 `sheetCount` 로 합친다.
 * 규격·단가·중량은 승인 시점 값을 복사해 넣어 나중에 기준정보가 바뀌어도
 * 과거 실적이 흔들리지 않는다(`D2-B06-E`).
 * 보유 수량은 관리하지 않는다(`D2-B06-G` (가)). 이 표는 그 자체로 수불 원장의
 * 출고 쪽 모양이라 나중에 입고를 얹을 때 버릴 것이 없다.
 * 남은 조각도 개체로 남기지 않는다(`D2-B06-H` 2026-08-30 (가)로 환원). 현장에서
 * 다시 쓰지 않는다는 것이 확인됐고, 쓰지 않는 것을 세면 틀린 숫자만 쌓인다.
 */
model SheetUsageRecord {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @db.Uuid
  salesOrderId          String              @db.Uuid
  cuttingPlanId         String              @db.Uuid
  cuttingPlanRevisionId String              @db.Uuid
  sheetItemId           String              @db.Uuid
  /**
   * 계약에 실렸던 원판 후보 id 원문. 지금은 원판 품목 id 그대로다.
   */
  sheetKey              String              @db.VarChar(150)
  status                SheetUsageStatus    @default(ACTIVE)
  label                 String              @db.VarChar(200)
  widthMm               Decimal             @db.Decimal(18, 6)
  lengthMm              Decimal             @db.Decimal(18, 6)
  sheetCount            Int
  totalAreaM2           Decimal             @db.Decimal(18, 8)
  placedAreaM2          Decimal             @db.Decimal(18, 8)
  /**
   * 부품이 덮지 않은 면적 전부. trim 과 자투리를 모두 담는다(`D2-B06-H` (가)).
   */
  lossAreaM2            Decimal             @db.Decimal(18, 8)
  yieldPercent          Decimal             @db.Decimal(6, 2)
  /**
   * 원판 한 장의 유효 중량. 밀도도 override 도 없으면 비워 둔다.
   */
  unitWeightKg          Decimal?            @db.Decimal(18, 6)
  totalWeightKg         Decimal?            @db.Decimal(18, 6)
  /**
   * 참고 매입원가(`D2-B06-D`). 판매가가 아니다. 없으면 비워 둔다.
   */
  unitCostKrw           Decimal?            @db.Decimal(20, 2)
  totalCostKrw          Decimal?            @db.Decimal(20, 2)
  voidedAt              DateTime?           @db.Timestamptz(6)
  voidReason            String?             @db.VarChar(500)
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @db.Timestamptz(6)
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesOrder            SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  cuttingPlan           CuttingPlan         @relation(fields: [cuttingPlanId], references: [id], onDelete: Cascade)
  cuttingPlanRevision   CuttingPlanRevision @relation(fields: [cuttingPlanRevisionId], references: [id], onDelete: Cascade)
  sheetItem             SheetItem           @relation(fields: [sheetItemId], references: [id], onDelete: Restrict)

  /// 겹쳐 쓰기는 살아 있는 실적에만 막는다. 무효 이력은 몇 겹이든 쌓인다(`D2-B06-F`).
  /// 부분 유일 인덱스 `SheetUsageRecord_one_active_per_revision_sheet_key` 는 Prisma 스키마로
  /// 표현되지 않아 migration SQL 에만 있다. `PriceBook`·`SheetItem` 과 같은 방식이다.
  @@index([cuttingPlanRevisionId, sheetKey], map: "SheetUsageRecord_revision_sheet_key")
  @@index([organizationId, status, createdAt], map: "SheetUsageRecord_organization_status_idx")
  @@index([organizationId, sheetItemId, status], map: "SheetUsageRecord_sheet_item_idx")
  @@index([salesOrderId], map: "SheetUsageRecord_order_idx")
  @@index([cuttingPlanId])
}
